# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PyInstaller
build/
dist/
*.spec
!packaging/deckle.spec

# Qt
*.qmlc
*.jsc

# Test fixtures. sample.pdf is the one exception: ~100 tests open it and a
# fresh clone must be green, so it is tracked. The golden Pinebox fixture
# is 30 MB and stays out -- its test skips when it is absent.
tests/fixtures/*.pdf
!tests/fixtures/sample.pdf

# Git Bash on Windows leaves crash dumps in the working tree
*.stackdump

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated API reference -- regenerate with `run.bat docs`, never commit
docs/api/_build/

# Tooling output, not source
graphify-out/
.forge-factory/
.converge-scratch/

# Factory/audit tool exhaust -- git history already holds these
*.audit-backup-*

# Clean build environment for packaging -- recreate with run.bat package
.buildenv/
